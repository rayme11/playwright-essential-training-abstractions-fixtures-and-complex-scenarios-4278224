{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM"],
    "types": ["node", "@playwright/test"],
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["lib/*"],
      "@pages/*": ["lib/pages/*"],
      "@datafactory/*": ["lib/pages/datafactory/*"],
      "@matchers/*": ["lib/matchers/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": ["tests/**/*", "lib/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
